{
  "name": "pur-2-file-format",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only TypeScript parser for the verified PureRef 2.1.3 format subset",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p typescript/tsconfig.json",
    "test": "npm run build && tsc -p typescript/tests/tsconfig.json && node --test typescript/tests/reader.test.mjs",
    "check:browser": "esbuild typescript/src/index.ts --bundle --platform=browser --format=esm --outfile=dist/browser-check.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.25.0",
    "sql.js": "^1.14.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
